# ==========================================================
# Inventário TI — Usina Caçu
# Copie este arquivo para ".env" e ajuste os valores conforme necessário.
# ==========================================================

# ---------- Banco de dados (Postgres) ----------
DB_USER=inventario
DB_PASSWORD=inventario
DB_NAME=inventario_ti
# Porta exposta do Postgres no host (útil para acessar com um cliente SQL local)
DB_EXPOSED_PORT=5432

# ---------- API ----------
# Porta da API exposta no host — mantida acessível fora do compose
# para uso futuro pelo app Android.
API_EXPOSED_PORT=3000

# Segredo usado para assinar os tokens JWT (access e refresh).
# Gere um valor aleatório forte em produção, ex: openssl rand -hex 32
JWT_SECRET=change-me-in-production

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Origens permitidas por CORS, separadas por vírgula.
# Inclua aqui o domínio do painel web e, futuramente, do app Android (se aplicável).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- Web (frontend) ----------
WEB_EXPOSED_PORT=8080
